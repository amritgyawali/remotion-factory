      "sourceId": "c30-d29-design-to-code",
      "template": "TechTip",
      "caption": "Getting from a design file to working markup is mostly about deciding three things before you write any CSS.\n\n#Frontend #DesignSystems #WebDev",
      "props": {
        "eyebrow": "MERITBYTE / QUICK WIN",
        "day": 1,
        "durationInSeconds": 20,
        "hook": "Design to code, three decisions",
        "steps": [
          "Name the spacing scale before the first margin",
          "Decide which values are tokens, not numbers",
          "Build the longest state first, not the prettiest"
        ],
        "result": "Building the happy path first guarantees rework.",
        "variant": "design-code",
        "kicker": "SAVE THIS",
        "exhibit": {
          "kind": "pipeline",
          "stages": [
            "Name the spacing scale before the first…",
            "Decide which values are tokens, not…",
            "Build the longest state first, not the…"
          ],
          "bottleneck": 2
