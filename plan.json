      "sourceId": "meritbyte-pdf-25",
      "template": "CaseStudy",
      "caption": "Safe support automation handles repetitive, reversible work and hands ambiguity to people. Judge it by resolution quality, not ticket deflection.\n\n#CustomerSupport #Automation #ResponsibleAI",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 6,
        "durationInSeconds": 22,
        "hook": "Automate repetition, not judgment",
