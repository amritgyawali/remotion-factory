  "items": [
    {
      "id": "d01-a",
      "sourceId": "meritbyte-pdf-01",
      "template": "DevJoke",
      "caption": "Logo feedback gets funny when scale replaces intent. Anchor every revision to hierarchy, legibility, and the job the page must do.\n\n#WebDesign #DesignProcess #DevHumor",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 1,
        "durationInSeconds": 17,
        "hook": "Make the logo bigger. Again.",
        "beats": [
          "Bigger crowds the navigation",
          "Bigger swallows the headline",
          "Bigger breaks the whole hierarchy"
        ],
        "punchline": "Start with the page's job.",
        "variant": "logo",
        "kicker": "DESIGN WITH INTENT"
      }
    },
    {
      "id": "d01-b",
      "sourceId": "meritbyte-pdf-02",
      "template": "TechTip",
      "caption": "A visible admin login is not proof of a breach. Check whether sensitive files are public, confirm access controls, and investigate before you conclude.\n\n#WebSecurity #SiteAudit #BuildBetter",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 1,
        "durationInSeconds": 22,
        "hook": "Three paths deserve a security check",
        "steps": [
          "/wp-admin may be expected",
          "Block public .git access",
          "Remove exposed backup files"
        ],
        "result": "Investigate exposure, not login screens.",
        "variant": "security",
        "kicker": "VERIFY FIRST"
      }
    },
    {
      "id": "d01-c",
      "sourceId": "meritbyte-pdf-03",
      "template": "SiteRoast",
      "caption": "A quick roast should diagnose friction, not invent conversion numbers. Start with speed, clarity, and the path to one useful action.\n\n#WebsiteAudit #UXDesign #Conversion",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 1,
        "durationInSeconds": 24,
        "hook": "This polished page still loses intent",
        "episode": "EP 01",
        "problems": [
          "Slow first view",
          "Offer stays vague",
          "Action hides below"
        ],
        "fix": "Lead with one clear promise",
        "verdict": "CLARITY FIRST",
        "kicker": "ROAST THE FRICTION"
      }
    },
    {
      "id": "d01-d",
      "sourceId": "meritbyte-pdf-04",
      "template": "FounderStory",
      "caption": "Strong work can still feel risky when progress is invisible. A short, predictable update gives clients evidence before doubt fills the gap.\n\n#ClientWork #ProjectManagement #FounderLessons",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 1,
        "durationInSeconds": 22,
        "hook": "Silence can lose good clients",
        "moments": [
          "The work starts out of sight",
          "Updates wait until the end",
          "Silence looks like inactivity"
        ],
        "turn": "Share progress before anyone asks",
        "lesson": "Trust needs visible evidence.",
        "kicker": "SHOW THE WORK"
      }
    },
    {
      "id": "d02-a",
      "sourceId": "meritbyte-pdf-05",
      "template": "DevJoke",
      "caption": "Local success only proves the local setup works. Match environments, test production-like config, and make deploys reproducible.\n\n#DevLife #Docker #SoftwareEngineering",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 2,
        "durationInSeconds": 15,
        "hook": "It works on my machine",
        "beats": [
          "Local tests glow green",
          "Production config disagrees",
          "The error graph wakes up"
        ],
        "punchline": "Ship the environment, not excuses.",
        "variant": "terminal",
        "kicker": "MATCH THE ENV"
      }
    },
    {
      "id": "d02-b",
      "sourceId": "meritbyte-pdf-06",
      "template": "CaseStudy",
      "caption": "Treat performance numbers as a diagnostic, not a client victory story. Measure the baseline, remove obvious weight, then test the same page again.\n\n#WebPerformance #Frontend #SiteSpeed",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 2,
        "durationInSeconds": 22,
        "hook": "Race the page, not the mockup",
        "before": "Slow paint hides the offer",
        "after": "Fast paint reveals the message",
        "actions": [
          "Compress oversized media",
          "Delay noncritical scripts",
          "Set deliberate cache rules"
        ],
        "lesson": "Measure each fix on the same page.",
        "kicker": "TEST THEN TUNE"
      }
    },
    {
      "id": "d02-c",
      "sourceId": "meritbyte-pdf-07",
      "template": "TechTip",
      "caption": "DevTools can capture a full page, copy a request, and pause only when a condition matches. Three small shortcuts, less debugging friction.\n\n#DevTools #FrontendTips #WebDevelopment",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 2,
        "durationInSeconds": 20,
        "hook": "Three DevTools moves worth learning",
        "steps": [
          "Capture a full-page screenshot",
          "Copy a request as fetch",
          "Pause on a matching condition"
        ],
        "result": "Less hunting. Faster debugging.",
        "variant": "devtools",
        "kicker": "SAVE THE SHORTCUTS"
      }
    },
    {
      "id": "d02-d",
      "sourceId": "meritbyte-pdf-08",
      "template": "DevJoke",
      "caption": "Good QA tries valid flows, edge cases, and recovery paths. The joke works because bizarre inputs are useful—but normal orders still need tests.\n\n#QualityAssurance #Testing #DevHumor",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 2,
        "durationInSeconds": 17,
        "hook": "A QA tester orders everything wrong",
        "beats": [
          "One beer, then zero beers",
          "Minus one, then a NULL order",
          "Every edge case gets a turn"
        ],
        "punchline": "Then test one normal order.",
        "variant": "qa",
        "kicker": "TEST THE HAPPY PATH"
      }
    },
    {
      "id": "d03-a",
      "sourceId": "meritbyte-pdf-09",
      "template": "SiteRoast",
      "caption": "If navigation works only with a mouse, the mobile experience is unfinished. Test the real tap path, stacking order, focus, and escape behavior.\n\n#MobileUX #Accessibility #WebDesign",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 3,
        "durationInSeconds": 22,
        "hook": "The menu opens behind the page",
        "episode": "EP 02",
        "problems": [
          "Layer order hides it",
          "Touch path goes untested",
          "Keyboard escape is missing"
        ],
        "fix": "Test every open and close path",
        "verdict": "SHIP AFTER TOUCH",
        "kicker": "TRY A REAL PHONE"
      }
    },
    {
      "id": "d03-b",
      "sourceId": "meritbyte-pdf-10",
      "template": "FounderStory",
      "caption": "A passing pipeline cannot cover a scenario nobody encoded. When a defect escapes, strengthen the process instead of blaming one line.\n\n#SoftwareTesting #EngineeringCulture #BuildBetter",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 3,
        "durationInSeconds": 22,
        "hook": "A green build can miss risk",
        "moments": [
          "The happy path passes",
          "A rare retry duplicates work",
          "The suite never asks why"
        ],
        "turn": "Add the missing failure case",
        "lesson": "Fix the process, not the person.",
        "kicker": "LEARN FROM ESCAPES"
      }
    },
    {
      "id": "d03-c",
      "sourceId": "meritbyte-pdf-11",
      "template": "TechTip",
      "caption": "A subscription is worth its total value, not its longest feature list. Audit usage, replacement cost, maintenance, and operational risk before renewal.\n\n#SaaS #TechStack #CostControl",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 3,
        "durationInSeconds": 20,
        "hook": "Audit the tools nobody questions",
        "steps": [
          "List the features actually used",
          "Price replacement and upkeep",
          "Keep what lowers real risk"
        ],
        "result": "Cancel waste, not leverage.",
        "variant": "tool-audit",
        "kicker": "REVIEW BEFORE RENEW"
      }
    },
    {
      "id": "d03-d",
      "sourceId": "meritbyte-pdf-12",
      "template": "DevJoke",
      "caption": "A standup needs a clear purpose, a tight timebox, and a parking lot for deep dives. Otherwise the meeting becomes the blocker.\n\n#TeamWork #Agile #DevHumor",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 3,
        "durationInSeconds": 16,
        "hook": "The standup outlived its timer",
        "beats": [
          "Updates become side quests",
          "The timebox turns red",
          "The sun moves. Nobody stops."
        ],
        "punchline": "Any blockers? This meeting.",
        "variant": "timer",
        "kicker": "PARK THE DEEP DIVE"
      }
    },
    {
      "id": "d04-a",
      "sourceId": "meritbyte-pdf-13",
      "template": "CaseStudy",
      "caption": "More pages do not automatically create more search value. Audit thin or overlapping content, consolidate carefully, and watch the evidence afterward.\n\n#TechnicalSEO #ContentStrategy #SiteAudit",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 4,
        "durationInSeconds": 22,
        "hook": "More pages can create more noise",
        "before": "Thin pages compete and confuse",
        "after": "Focused pages answer clear intent",
        "actions": [
          "Map each page to intent",
          "Merge genuine overlap",
          "Redirect removed URLs carefully"
        ],
        "lesson": "Consolidate from evidence, not a quota.",
        "kicker": "QUALITY OVER COUNT"
      }
    },
    {
      "id": "d04-b",
      "sourceId": "meritbyte-pdf-14",
      "template": "FounderStory",
      "caption": "Waiting to be discovered is not a pipeline. Define who you help, write a useful message, and learn from replies without turning outreach into spam.\n\n#FounderLife #BusinessGrowth #SalesProcess",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 4,
        "durationInSeconds": 20,
        "hook": "Waiting is not a pipeline",
        "moments": [
          "The inbox stays quiet",
          "Refresh changes nothing",
          "A useful list takes shape"
        ],
        "turn": "Start a respectful conversation",
        "lesson": "Momentum begins with a clear offer.",
        "kicker": "STOP WAITING"
      }
    },
    {
      "id": "d04-c",
      "sourceId": "meritbyte-pdf-15",
      "template": "SiteRoast",
      "caption": "A self-roast is useful only when it becomes a repair list. Inspect your own speed, message, navigation, and primary action with the same honesty.\n\n#WebsiteAudit #AgencyLife #UXReview",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 4,
        "durationInSeconds": 22,
        "hook": "Roast your own site first",
        "episode": "OWN SITE",
        "problems": [
          "Heavy first view",
          "Primary action gets buried",
          "The message wanders"
        ],
        "fix": "Publish the repair list",
        "verdict": "NO EXCUSES",
        "kicker": "AUDIT YOURSELF"
      }
    },
    {
      "id": "d04-d",
      "sourceId": "meritbyte-pdf-16",
      "template": "DevJoke",
      "caption": "A small request can hide product decisions, data work, permissions, testing, and support. Clarify scope before a sentence becomes a surprise roadmap.\n\n#ScopeCreep #ProductManagement #DevHumor",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 4,
        "durationInSeconds": 16,
        "hook": "Just one small thing",
        "beats": [
          "One button needs a form",
          "The form needs user accounts",
          "Accounts need a dashboard"
        ],
        "punchline": "Small sentence. Real project.",
        "variant": "scope",
        "kicker": "NAME THE SCOPE"
      }
    },
    {
      "id": "d05-a",
      "sourceId": "meritbyte-pdf-18",
      "template": "CaseStudy",
      "caption": "Removing a secret from the latest commit does not erase its history. Rotate it first, scan the repository, and block future leaks.\n\n#CyberSecurity #Git #SecureCoding",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 5,
        "durationInSeconds": 22,
        "hook": "Deleted secrets can survive in Git",
        "before": "A credential enters history",
        "after": "The key is rotated and blocked",
        "actions": [
          "Rotate the exposed credential",
          "Scan history and active branches",
          "Enable secret scanning"
        ],
        "lesson": "Deletion is cleanup. Rotation is safety.",
        "kicker": "ROTATE THEN CLEAN"
      }
    },
    {
      "id": "d05-b",
      "sourceId": "meritbyte-pdf-19",
      "template": "FounderStory",
      "caption": "Progress rarely arrives as one dramatic day. Repeated commits, conversations, and small improvements compound into a body of work.\n\n#FounderJourney #Consistency #BuildInPublic",
