        "eyebrow": "MeritByte — Build Better",
        "day": 6,
        "durationInSeconds": 16,
        "hook": "Feedback arrived in a Word document",
        "beats": [
          "Make it bigger, then smaller",
          "Make it premium, then playful",
          "Use the old version again"
