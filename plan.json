        "punchline": "No owner? Move the deploy.",
        "variant": "deploy",
        "kicker": "PLAN THE ROLLBACK"
      }
    },
    {
      "id": "d05-d",
      "sourceId": "meritbyte-pdf-21",
      "template": "TechTip",
      "caption": "Core Web Vitals describe loading, responsiveness, and visual stability. They matter for users and search, but they are not the whole ranking system.\n\n#CoreWebVitals #TechnicalSEO #WebPerformance",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 5,
        "durationInSeconds": 20,
        "hook": "Three metrics expose shaky experiences",
        "steps": [
          "LCP: loading of main content",
          "INP: response to interaction",
          "CLS: unexpected layout movement"
        ],
        "result": "Useful signals, not the whole ranking.",
        "variant": "vitals",
        "kicker": "MEASURE EXPERIENCE"
      }
    },
    {
      "id": "d06-a",
      "sourceId": "meritbyte-pdf-22",
      "template": "SiteRoast",
      "caption": "Long forms can be right for complex work, but every field needs a reason. Remove redundant questions, preserve qualification, and test completion.\n\n#FormDesign #ConversionUX #WebsiteRoast",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 6,
        "durationInSeconds": 22,
        "hook": "This download form asks too much",
