    {
      "id": "d06-b",
      "sourceId": "meritbyte-pdf-23",
      "template": "FounderStory",
      "caption": "Maintenance is rarely glamorous, yet patches, monitoring, and steady improvements protect the work that gets attention.\n\n#Maintenance #FounderMindset #SustainableBusiness",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 6,
        "durationInSeconds": 18,
        "hook": "Boring work keeps products alive",
        "moments": [
          "Patches close quiet risks",
          "Monitoring catches drift",
          "Small fixes prevent large ones"
        ],
        "turn": "Reliability grows off camera",
        "lesson": "Consistency compounds without applause.",
        "kicker": "RESPECT THE ROUTINE"
