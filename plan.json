        "eyebrow": "MeritByte — Build Better",
        "day": 5,
        "durationInSeconds": 18,
        "hook": "Progress hides inside boring days",
        "moments": [
          "One repository becomes a habit",
          "Small releases stack quietly",
          "Useful conversations compound"
        ],
        "turn": "Nothing hinges on one milestone",
        "lesson": "Repeat the work that earns trust.",
        "kicker": "KEEP SHIPPING"
      }
    },
    {
      "id": "d05-c",
      "sourceId": "meritbyte-pdf-20",
      "template": "DevJoke",
      "caption": "A late-week deploy is not automatically reckless; an unowned deploy is. Use observability, a rollback path, and people who can respond.\n\n#DevOps #Deployment #DevHumor",
      "props": {
        "eyebrow": "MeritByte — Build Better",
        "day": 5,
        "durationInSeconds": 15,
