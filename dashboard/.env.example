# Copy to .env.local for local development. In production these are set in
# Vercel under Settings > Environment Variables. None of them are exposed to
# the browser: every value is read only in server components and route handlers.

# --- Repository -------------------------------------------------------------
# Fine-grained personal access token scoped to this one repository, with:
#   Contents: read and write   (read plans/state, commit plan edits)
#   Actions:  read and write   (list runs, read logs, dispatch workflows)
# Nothing else. https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=amritgyawali/remotion-factory
GITHUB_BRANCH=main

# --- Dashboard access -------------------------------------------------------
# The password you type to get in. Make it long: this console can publish.
DASHBOARD_PASSWORD=
# Signs the session cookie. Must differ from the password, min 32 chars.
#   openssl rand -hex 32
DASHBOARD_SECRET=

# --- Postiz (optional) ------------------------------------------------------
# Omit both and the dashboard still works; the Postiz panels report "not set".
# Use the API origin, not the web app: hosted is https://api.postiz.com,
# self-hosted is https://<your-host>/api. "/public/v1" is appended for you.
POSTIZ_API_URL=
POSTIZ_API_KEY=

# --- Schedule ---------------------------------------------------------------
# Must match MIN_GAP_HOURS in the workflow, or the dashboard will predict the
# next posting slot incorrectly.
MIN_GAP_HOURS=5
